{
  "name": "mbaretefit-wod",
  "private": true,
  "version": "0.1.0",
  "description": "MBARETEFIT WOD: calculadora de cargas, porcentajes de RM y discos por lado para atletas y coaches de CrossFit.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
